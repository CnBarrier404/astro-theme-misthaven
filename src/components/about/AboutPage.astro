---
import { Image } from "astro:assets";
import ContactLink from "@/components/about/ContactLink.astro";
import Card from "@/components/ui/Card.astro";
import ThemedImage from "@/components/ui/ThemedImage.astro";
import { aboutConfig } from "@/config/aboutConfig";
import { siteConfig } from "@/config/siteConfig";
import { getTranslator, I18nKey } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolveSiteAsset } from "@/utils/assets";

interface Props {
  title?: string;
  description?: string;
}

const { title = aboutConfig.pageTitle, description = aboutConfig.pageDescription } = Astro.props;
const t = getTranslator();
const bannerLight = resolveSiteAsset(siteConfig.heroImageLight);
const bannerDark = resolveSiteAsset(siteConfig.heroImageDark);
---

<BaseLayout title={`${title} · ${siteConfig.title}`} description={description}>
  <div class="mx-auto grid w-full max-w-reading gap-4 tablet:gap-6">
    <Card as="header" class="overflow-hidden">
      <div class="relative h-32 bg-profile-hero tablet:h-48">
        <ThemedImage
          class="absolute inset-0 size-full object-cover object-[center_60%]"
          light={bannerLight}
          dark={bannerDark}
          priority
        />
      </div>

      <div class="px-5 pb-8 tablet:px-12 tablet:pb-10">
        <Image
          class="relative -mt-12 size-24 rounded-full border-4 border-surface bg-surface object-cover shadow-sm shadow-shadow tablet:-mt-14 tablet:size-28"
          src={siteConfig.gravatarUrl}
          width={224}
          height={224}
          alt=""
          priority
        />
        <div class="mt-4 flex flex-col gap-5 tablet:flex-row tablet:items-end tablet:justify-between tablet:gap-8">
          <div class="min-w-0">
            <p class="m-0 text-xs font-bold text-accent-strong">ABOUT</p>
            <h1 class="mt-1 mb-0 text-page-title font-bold">{siteConfig.owner}</h1>
            <p class="mt-2 mb-0 max-w-xl text-sm leading-7 text-text-soft tablet:text-base">{aboutConfig.tagline}</p>
          </div>
          {aboutConfig.links.length > 0 && (
            <ul class="m-0 flex flex-none list-none flex-wrap gap-3 p-0" aria-label={t(I18nKey.aboutContactLinks)}>
              {aboutConfig.links.map((link) => (
                <li>
                  <ContactLink {...link} />
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </Card>

    <Card as="article">
      <div class="prose-content px-5 py-8 tablet:px-12 tablet:py-10 tablet:pb-14">
        <slot />
      </div>
    </Card>
  </div>
</BaseLayout>
