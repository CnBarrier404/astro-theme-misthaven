---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  name: string;
  showName?: boolean;
  url: string;
}

const { icon, name, showName = true, url } = Astro.props;
const isExternal = url.startsWith("https://") || url.startsWith("http://");
---

<a
  class:list={[
    "inline-flex h-10 items-center justify-center gap-2 rounded-panel border border-border bg-surface text-sm font-medium text-text-soft transition-colors hover:border-border-strong hover:bg-accent-soft hover:text-accent-strong",
    showName ? "px-4" : "w-10",
  ]}
  href={url}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noreferrer" : undefined}
  aria-label={!showName ? name : undefined}
  title={!showName ? name : undefined}
>
  <Icon name={icon} size={18} is:inline aria-hidden="true" />
  {showName && <span>{name}</span>}
</a>
