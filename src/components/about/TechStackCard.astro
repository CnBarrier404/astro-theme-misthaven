---
import Card from "@/components/ui/Card.astro";
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  name: string;
}

const { icon, name } = Astro.props;
---

<Card as="article" class="flex min-h-28 flex-col items-center justify-center px-6 py-6 text-center">
  <span class="grid size-11 place-items-center rounded-panel bg-accent-soft text-accent-strong">
    <Icon name={icon} size={24} is:inline aria-hidden="true" />
  </span>
  <h3 class="mt-4 mb-0 text-base font-bold text-text">{name}</h3>
</Card>
