---
import Card from "@/components/ui/Card.astro";
import { siteConfig } from "@/config/siteConfig";
import { getTranslator, I18nKey } from "@/i18n";
import "artalk/Artalk.css";
import "@/styles/integrations/artalk.css";
import type { ArtalkCommentConfig } from "@/types/commentConfig";

interface Props {
  config: ArtalkCommentConfig;
  pageKey: string;
  pageTitle: string;
}

const { config, pageKey, pageTitle } = Astro.props;
const t = getTranslator();
---

<Card
  as="section"
  class="mt-5 px-5 py-7 tablet:mt-6 tablet:px-12 tablet:py-9"
  aria-labelledby="comments-title"
  data-artalk-comments
  data-comment-error={t(I18nKey.commentsLoadError)}
  data-locale={siteConfig.lang}
  data-page-key={pageKey}
  data-page-title={pageTitle}
  data-read-only-message={t(I18nKey.commentsReadOnly)}
  data-server={config.server}
  data-site={siteConfig.title}
  data-site-origin={new URL(siteConfig.siteUrl).origin}
  data-visitor-count={String(config.visitorCount)}
>
  <header class="mb-6 border-b border-border pb-4">
    <h2 class="m-0 text-xl font-bold" id="comments-title">
      {t(I18nKey.commentsTitle)}
    </h2>
    <p class="mt-2 mb-0 text-sm leading-6 text-warning" data-comment-read-only-notice hidden>
      {t(I18nKey.commentsReadOnly)}
    </p>
    <p class="mt-2 mb-0 text-sm leading-6 text-draft" role="status" data-comment-status hidden></p>
  </header>

  <div data-artalk-container></div>
</Card>

<script>
  const setupArtalkComments = async () => {
    const sections = document.querySelectorAll<HTMLElement>("[data-artalk-comments]");

    for (const section of sections) {
      if (section.dataset.artalkReady) continue;
      section.dataset.artalkReady = "true";

      const container = section.querySelector<HTMLElement>("[data-artalk-container]");
      const readOnlyNotice = section.querySelector<HTMLElement>("[data-comment-read-only-notice]");
      const status = section.querySelector<HTMLElement>("[data-comment-status]");
      const server = section.dataset.server;
      const site = section.dataset.site;
      const siteOrigin = section.dataset.siteOrigin;
      const locale = section.dataset.locale;
      const pageKey = section.dataset.pageKey;
      const pageTitle = section.dataset.pageTitle;
      const readOnlyMessage = section.dataset.readOnlyMessage ?? "";
      const commentError = section.dataset.commentError ?? "";

      if (!container || !server || !site || !siteOrigin || !locale || !pageKey || !pageTitle) continue;

      const isProductionSite = import.meta.env.PROD && window.location.origin === siteOrigin;
      const visitorCountEnabled = section.dataset.visitorCount === "true";
      const isReadOnly = !isProductionSite;
      section.toggleAttribute("data-comment-read-only", isReadOnly);
      if (readOnlyNotice) readOnlyNotice.hidden = !isReadOnly;

      let postViewCount: HTMLElement | null = null;
      const showViewError = () => {
        if (!postViewCount || !postView) return;
        const currentCount = Number(postViewCount.textContent?.trim());
        if (Number.isFinite(currentCount) && currentCount > 0) return;

        postViewCount.textContent = postView.dataset.viewPlaceholder ?? "-";
      };

      const showError = () => {
        showViewError();
        if (!status) return;
        status.textContent = commentError;
        status.hidden = false;
      };

      const hideError = () => {
        if (status) status.hidden = true;
      };

      let pvSelector = "[data-artalk-pv-disabled]";
      const postView = document.querySelector<HTMLElement>(`[data-post-view][data-page-key="${CSS.escape(pageKey)}"]`);

      if (visitorCountEnabled && postView) {
        const value = postView.querySelector<HTMLElement>("[data-post-view-value]");
        const placeholder = postView.dataset.viewPlaceholder ?? "-";

        if (value) {
          const count = document.createElement("span");
          count.id = "post-view-count";
          count.className = "artalk-pv-count";
          count.dataset.pageKey = pageKey;
          count.textContent = placeholder;
          value.replaceChildren(count);
          postViewCount = count;
          pvSelector = "#post-view-count";

          const viewCountObserver = new MutationObserver(() => {
            const currentCount = Number(count.textContent?.trim());
            if (!Number.isFinite(currentCount)) return;

            viewCountObserver.disconnect();
            if (currentCount <= 0) count.textContent = placeholder;
          });
          viewCountObserver.observe(count, { childList: true, characterData: true, subtree: true });

          window.setTimeout(() => {
            viewCountObserver.disconnect();
            if (!Number.isFinite(Number(count.textContent?.trim()))) showViewError();
          }, 10000);
        }
      }

      try {
        const { default: Artalk } = await import("artalk");
        const instance = Artalk.init({
          el: container,
          server,
          site,
          locale,
          pageKey,
          pageTitle,
          darkMode: document.documentElement.dataset.theme === "dark",
          preferRemoteConf: false,
          pvAdd: isProductionSite && visitorCountEnabled,
          pvEl: pvSelector,
          ...(isReadOnly
            ? {
                vote: false,
                voteDown: false,
                pageVote: false,
                imgUpload: false,
                beforeSubmit: (editor: { showNotify: (message: string, type: "w") => void }) => {
                  editor.showNotify(readOnlyMessage, "w");
                },
              }
            : {}),
        });

        const commentLoadTimeout = window.setTimeout(showError, 10000);
        instance.on("list-loaded", () => {
          window.clearTimeout(commentLoadTimeout);
          hideError();
        });
        instance.on("list-failed", () => {
          window.clearTimeout(commentLoadTimeout);
          showError();
        });

        const root = document.documentElement;
        const themeObserver = new MutationObserver(() => {
          instance.setDarkMode(root.dataset.theme === "dark");
        });
        themeObserver.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
      } catch (error) {
        showError();
        console.error("Failed to initialize Artalk comments", error);
      }
    }
  };

  setupArtalkComments();
  document.addEventListener("astro:page-load", setupArtalkComments);
</script>
