---
import { commentConfig, isCommentViewCountEnabled } from "@/config/commentConfig";
import { siteConfig } from "@/config/siteConfig";

const artalkConfig = isCommentViewCountEnabled ? commentConfig.artalk : null;
---

{artalkConfig?.visitorCount && (
  <div data-comment-view-counts data-server={artalkConfig.server} data-site={siteConfig.title} hidden />
)}

<script>
  type ViewCounts = Record<string, number>;

  const setupCommentViewCounts = async () => {
    const loader = document.querySelector<HTMLElement>("[data-comment-view-counts]");
    if (!loader || loader.dataset.viewCountsReady) return;
    loader.dataset.viewCountsReady = "true";

    const server = loader.dataset.server;
    const site = loader.dataset.site;
    if (!server || !site) return;

    const pageKeys = [
      ...new Set(
        [...document.querySelectorAll<HTMLElement>("[data-post-list-item][data-post-path]")]
          .map((item) => item.dataset.postPath)
          .filter((path): path is string => Boolean(path)),
      ),
    ];
    if (pageKeys.length === 0) return;

    try {
      const url = new URL(`${server.replace(/\/+$/, "")}/api/v2/stats/page_pv`, window.location.origin);
      url.search = new URLSearchParams({ page_keys: pageKeys.join(","), site_name: site }).toString();

      const response = await fetch(url);
      if (!response.ok) throw new Error(`Artalk stats request failed: ${response.status}`);

      const { data } = await response.json();
      const counts: ViewCounts = {};
      for (const pageKey of pageKeys) {
        const count = data?.[pageKey] ?? 0;
        if (typeof count === "number" && Number.isFinite(count)) counts[pageKey] = count;
      }

      document.dispatchEvent(new CustomEvent("post-view-counts", { detail: { counts } }));
    } catch (error) {
      console.error("Failed to load Artalk view counts", error);
    }
  };

  setupCommentViewCounts();
  document.addEventListener("astro:page-load", setupCommentViewCounts);
</script>
