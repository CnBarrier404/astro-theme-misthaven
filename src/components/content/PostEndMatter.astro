---
import Icon from "@/components/ui/Icon.astro";
import Card from "@/components/ui/Card.astro";
import { postConfig } from "@/config/postConfig";
import { getTranslator, I18nKey } from "@/i18n";
import { getPostHref, type PostEntry } from "@/utils/posts";

interface Props {
  previousPost?: PostEntry;
  nextPost?: PostEntry;
}

const { previousPost, nextPost } = Astro.props;
const t = getTranslator();
const license = postConfig.license.trim();
const hasNavigation = Boolean(previousPost || nextPost);
---

{(license || hasNavigation) && (
  <div class="mt-4 space-y-4">
    {license && (
      <Card as="section" aria-labelledby="post-information-title" class="overflow-hidden">
        <div class="px-5 py-5 tablet:px-8 tablet:py-6">
          <h2 id="post-information-title" class="m-0 text-base font-bold">
            {t(I18nKey.postInformation)}
          </h2>
          <div class="mt-4 flex items-center gap-3">
            <span class="grid size-8 flex-none place-items-center rounded-md bg-accent-soft text-accent-strong">
              <Icon name="cc" size={18} />
            </span>
            <span class="min-w-0">
              <span class="block text-xs text-muted">{t(I18nKey.postLicense)}</span>
              <span class="block text-sm leading-6 text-text-soft">{license}</span>
            </span>
          </div>
        </div>
      </Card>
    )}

    {hasNavigation && (
      <Card as="nav" class="grid grid-cols-2 overflow-hidden" aria-label={t(I18nKey.postNavigation)}>
        {previousPost ? (
          <a
            class="group flex min-h-24 min-w-0 items-center gap-3 border-r border-border px-4 py-4 transition-colors hover:bg-accent-soft tablet:gap-4 tablet:px-6"
            href={getPostHref(previousPost)}
            aria-label={t(I18nKey.postPreviousLink, { title: previousPost.data.title })}
          >
            <Icon class="flex-none rotate-180 text-accent-strong" name="arrow" size={20} />
            <span class="min-w-0">
              <span class="block text-xs font-medium text-accent-strong">{t(I18nKey.postPrevious)}</span>
              <span class="mt-1 line-clamp-2 block text-sm leading-6 text-text-soft">{previousPost.data.title}</span>
            </span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
        {nextPost ? (
          <a
            class="group flex min-h-24 min-w-0 items-center justify-end gap-3 px-4 py-4 text-right transition-colors hover:bg-accent-soft tablet:gap-4 tablet:px-6"
            href={getPostHref(nextPost)}
            aria-label={t(I18nKey.postNextLink, { title: nextPost.data.title })}
          >
            <span class="min-w-0">
              <span class="block text-xs font-medium text-accent-strong">{t(I18nKey.postNext)}</span>
              <span class="mt-1 line-clamp-2 block text-sm leading-6 text-text-soft">{nextPost.data.title}</span>
            </span>
            <Icon class="flex-none text-accent-strong" name="arrow" size={20} />
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
      </Card>
    )}
  </div>
)}
