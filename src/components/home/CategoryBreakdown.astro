---
import Card from "@/components/ui/Card.astro";
import { getTranslator, I18nKey } from "@/i18n";
import type { CategoryCount } from "@/types/home";
import { formatPostCount } from "@/utils/posts";

interface Props {
  categories: readonly CategoryCount[];
  title: string;
}

const { categories, title } = Astro.props;
const t = getTranslator();
const maxCount = Math.max(1, ...categories.map((category) => category.count));
---

<Card as="section" class="px-6 py-5 tablet:p-8" aria-labelledby="categories-title">
  <h2 class="m-0 text-sm font-semibold tablet:text-base" id="categories-title">
    {title}
  </h2>
  <!-- Each row runs a site search for its category; see `Search.astro`. -->
  <ul class="-mx-2 mt-3 mb-0 grid list-none gap-1 p-0">
    {categories.map((category) => (
      <li>
        <button
          class="group block w-full cursor-pointer rounded-md px-2 py-2 text-start transition-colors hover:bg-accent-soft/50"
          type="button"
          aria-label={t(I18nKey.searchFor, { query: category.name })}
          data-search-query={category.name}
        >
          <span class="flex items-center justify-between gap-3 text-sm">
            <span class="min-w-0 wrap-anywhere text-text-soft transition-colors group-hover:text-accent-strong">
              {category.name}
            </span>
            <span class="flex-none text-xs text-muted">{formatPostCount(category.count)}</span>
          </span>
          <span class="mt-1 block h-1 overflow-hidden rounded-sm bg-accent-soft" aria-hidden="true">
            <span
              class="block h-full rounded-sm bg-accent"
              style={`inline-size: ${(category.count / maxCount) * 100}%`}
            />
          </span>
        </button>
      </li>
    ))}
  </ul>
</Card>
