---
import ThemedImage from "@/components/ui/ThemedImage.astro";

interface Props {
  title: string;
  subTitle: string;
  description: readonly string[];
  imageLightSrc: ImageMetadata | null;
  imageDarkSrc: ImageMetadata | null;
}

const { title, subTitle, description, imageLightSrc, imageDarkSrc } = Astro.props;
---

<section
  class="relative flex min-h-[30.625rem] items-end overflow-hidden rounded-panel border border-border/75 bg-hero after:absolute after:inset-0 after:bg-hero-mobile tablet:min-h-112 tablet:items-center tablet:after:bg-hero-wide"
  aria-labelledby="hero-title"
>
  <ThemedImage
    class="absolute inset-0 size-full object-cover object-[66%_center] tablet:object-[center_48%]"
    light={imageLightSrc}
    dark={imageDarkSrc}
    priority
  />
  <div class="relative z-10 w-full px-6 py-8 tablet:w-3/5 tablet:px-[6.8%] tablet:py-15">
    <h1 class="m-0 font-extrabold text-hero-title text-text tablet:text-hero-wide" id="hero-title">
      <span class="relative inline bg-title-highlight bg-[length:100%_0.4375rem] bg-[position:0_93%] bg-no-repeat tablet:inline-block tablet:bg-none tablet:after:absolute tablet:after:bottom-2 tablet:after:left-0 tablet:after:-z-10 tablet:after:h-2 tablet:after:w-full tablet:after:rounded-panel tablet:after:bg-coral/60">
        {title}
      </span>
    </h1>
    <p class="mt-2 mb-0 text-2xl leading-normal font-medium text-text-soft tablet:mt-3 tablet:text-3xl">{subTitle}</p>
    <p class="mt-5 mb-0 max-w-lg text-sm leading-7 text-text-soft tablet:mt-6 tablet:max-w-2xl tablet:text-lg">
      {description.map((line, index) => (
        <>
          {line}
          {index < description.length - 1 && <br />}
        </>
      ))}
    </p>
  </div>
</section>
