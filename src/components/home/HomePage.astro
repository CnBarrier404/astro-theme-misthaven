---
import PostList from "@/components/post/PostList.astro";
import Card from "@/components/ui/Card.astro";
import CategoryBreakdown from "@/components/home/CategoryBreakdown.astro";
import Hero from "@/components/home/Hero.astro";
import Icon from "@/components/ui/Icon.astro";
import PopularTags from "@/components/home/PopularTags.astro";
import PostSort from "@/components/post/PostSort.astro";
import SiteStats from "@/components/home/SiteStats.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { siteConfig } from "@/config/siteConfig";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getTranslator, I18nKey } from "@/i18n";
import type { CategoryCount, SiteStat } from "@/types/home";
import { resolveSiteAsset } from "@/utils/assets";
import { getVisiblePosts } from "@/utils/posts";

const t = getTranslator();
const posts = await getVisiblePosts();
const categoryCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();

for (const post of posts) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);

  for (const tag of new Set(post.data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

function sortByCount(counts: Map<string, number>) {
  return [...counts.entries()].sort(([leftName, leftCount], [rightName, rightCount]) => {
    return rightCount - leftCount || leftName.localeCompare(rightName, siteConfig.lang);
  });
}

const popularTags = sortByCount(tagCounts)
  .slice(0, 6)
  .map(([tag]) => tag);
const categories = sortByCount(categoryCounts)
  .slice(0, 6)
  .map(([name, count]) => ({ name, count })) satisfies CategoryCount[];
const stats = [
  { value: String(posts.length), icon: "article", label: t(I18nKey.statsPosts) },
  { value: String(categoryCounts.size), icon: "folder", label: t(I18nKey.statsCategories) },
  { value: String(tagCounts.size), icon: "tag", label: t(I18nKey.statsTags) },
] satisfies readonly SiteStat[];
const postsHref = "/posts";
const heroImageLight = resolveSiteAsset(siteConfig.heroImageLight);
const heroImageDark = resolveSiteAsset(siteConfig.heroImageDark);
---

<BaseLayout title={`${siteConfig.title} · ${siteConfig.subTitle}`}>
  <Hero
    title={siteConfig.title}
    subTitle={siteConfig.subTitle}
    description={siteConfig.description}
    imageLightSrc={heroImageLight}
    imageDarkSrc={heroImageDark}
  />

  <div
    class="mt-5 grid grid-cols-1 gap-5 tablet:mt-6 tablet:gap-6 wide:grid-cols-[minmax(0,8fr)_minmax(0,2fr)]"
    id="latest"
  >
    <div class="grid content-start gap-4 tablet:gap-6">
      {posts.length > 0 ? (
        <section aria-labelledby="recent-title">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 class="m-0 text-lg font-bold" id="recent-title">
              {t(I18nKey.postsList)}
            </h2>
            <PostSort targetId="home-post-list" />
          </div>
          <PostList id="home-post-list" posts={posts} limit={5} ariaLabel={t(I18nKey.postsList)} />
          <div class="mt-5 flex justify-end">
            <TextLink href={postsHref}>
              {t(I18nKey.viewAllPosts)}
              <Icon class="size-5" name="arrow" size={20} />
            </TextLink>
          </div>
        </section>
      ) : (
        <Card as="section" class="px-6 py-10 text-center text-muted">
          <p class="m-0">{t(I18nKey.noPublishedPosts)}</p>
        </Card>
      )}
    </div>

    <aside
      class="grid grid-cols-1 content-start gap-4 tablet:gap-6 tablet:max-wide:grid-cols-2"
      aria-label={t(I18nKey.siteInformation)}
    >
      <SiteStats stats={stats} title={t(I18nKey.siteOverview)} />
      {popularTags.length > 0 && (
        <PopularTags tags={popularTags} title={t(I18nKey.popularTags)} tagsLabel={t(I18nKey.navigationTags)} />
      )}
      {categories.length > 0 && <CategoryBreakdown categories={categories} title={t(I18nKey.categoryBreakdown)} />}
    </aside>
  </div>
</BaseLayout>
