---
import Card from "@/components/ui/Card.astro";
import IconText from "@/components/ui/IconText.astro";
import type { SiteStat } from "@/types/home";

interface Props {
  stats: readonly SiteStat[];
  title: string;
}

const { stats, title } = Astro.props;
---

<Card as="section" class="px-6 py-5 tablet:p-8" aria-labelledby="stats-title">
  <h2 class="m-0 text-sm font-semibold tablet:text-base" id="stats-title">
    {title}
  </h2>
  <dl class="mt-4 mb-0 grid gap-2">
    {stats.map((stat) => (
      <div class="flex items-center justify-between gap-3 text-sm">
        <dt class="text-text-soft">
          <IconText icon={stat.icon}>{stat.label}</IconText>
        </dt>
        <dd class="m-0 font-medium tabular-nums">{stat.value}</dd>
      </div>
    ))}
  </dl>
</Card>
