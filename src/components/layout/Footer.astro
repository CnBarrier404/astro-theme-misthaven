---
import { footerConfig } from "@/config/footerConfig";
import { siteConfig } from "@/config/siteConfig";
import { I18nKey, t } from "@/i18n";

const currentYear = new Date().getFullYear();
const credits = [
  { label: "Astro", href: "https://astro.build" },
  { label: "Misthaven", href: "https://github.com/CnBarrier404/astro-theme-misthaven" },
];
---

<footer class="mx-auto mt-4 w-layout-width max-w-page py-6 text-center text-xs leading-7 text-muted tablet:w-layout-width-tablet tablet:py-8 tablet:text-sm wide:w-layout-width-wide">
  <nav class="mb-1 flex flex-wrap justify-center gap-x-2" aria-label={t(I18nKey.footerNavigation)}>
    {footerConfig.links.map((item, index) => {
      return (
        <>
          <a class="transition-colors hover:text-accent-strong" href={item.href}>
            {t(item.labelKey)}
          </a>
          {index < footerConfig.links.length - 1 && <span aria-hidden="true">|</span>}
        </>
      );
    })}
  </nav>
  <p class="m-0">{t(I18nKey.footerCopyright, { year: currentYear, owner: siteConfig.owner })}</p>
  <p class="mt-1 mb-0">
    {t(I18nKey.footerPoweredBy)}{" "}
    {credits.map(({ label, href }, index) => (
      <>
        {index > 0 && " & "}
        <a
          class="font-semibold text-text-soft transition-colors hover:text-accent-strong"
          href={href}
          target="_blank"
          rel="noreferrer"
        >
          {label}
        </a>
      </>
    ))}
  </p>
</footer>
