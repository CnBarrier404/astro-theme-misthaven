---
import PostList from "@/components/content/PostList.astro";
import Card from "@/components/ui/Card.astro";
import Hero from "@/components/ui/Hero.astro";
import Icon from "@/components/ui/Icon.astro";
import PopularTags from "@/components/ui/PopularTags.astro";
import PostSort from "@/components/ui/PostSort.astro";
import QuoteCard from "@/components/ui/QuoteCard.astro";
import SiteStats from "@/components/ui/SiteStats.astro";
import { siteConfig } from "@/config/siteConfig";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getTranslator, I18nKey } from "@/i18n";
import type { SiteStat } from "@/types/home";
import { resolveSiteAsset } from "@/utils/assets";
import { getVisiblePosts } from "@/utils/posts";

const t = getTranslator();
const posts = await getVisiblePosts();
const categoryCount = new Set(posts.map((post) => post.data.category)).size;
const tagCounts = new Map<string, number>();

for (const post of posts) {
  for (const tag of new Set(post.data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const popularTags = [...tagCounts.entries()]
  .sort(([leftTag, leftCount], [rightTag, rightCount]) => {
    return rightCount - leftCount || leftTag.localeCompare(rightTag, siteConfig.lang);
  })
  .slice(0, 6)
  .map(([tag]) => tag);
const stats = [
  { value: String(posts.length), icon: "article", label: t(I18nKey.statsPosts) },
  { value: String(categoryCount), icon: "folder", label: t(I18nKey.statsCategories) },
  { value: String(tagCounts.size), icon: "tag", label: t(I18nKey.statsTags) },
] satisfies readonly SiteStat[];
const postsHref = "/posts";
const heroImageLight = resolveSiteAsset(siteConfig.heroImageLight);
const heroImageDark = resolveSiteAsset(siteConfig.heroImageDark);
---

<BaseLayout title={`${siteConfig.title} · ${siteConfig.subTitle}`}>
  <Hero
    title={siteConfig.title}
    subTitle={siteConfig.subTitle}
    description={siteConfig.description}
    imageLightSrc={heroImageLight}
    imageDarkSrc={heroImageDark}
  />

  <div
    class="mt-5 grid grid-cols-1 gap-5 tablet:mt-6 tablet:gap-6 wide:grid-cols-[minmax(0,8fr)_minmax(0,2fr)]"
    id="latest"
  >
    <div class="grid content-start gap-4 tablet:gap-6">
      {posts.length > 0 ? (
        <section aria-labelledby="recent-title">
          <div class="mb-4 flex items-center justify-between gap-4">
            <h2 class="m-0 text-lg font-bold" id="recent-title">
              {t(I18nKey.postsList)}
            </h2>
            <PostSort targetId="home-post-list" />
          </div>
          <PostList id="home-post-list" posts={posts} limit={5} ariaLabel={t(I18nKey.postsList)} />
          <a class="mt-5 ml-auto flex w-fit items-center gap-2 text-sm font-bold text-accent-strong" href={postsHref}>
            {t(I18nKey.viewAllPosts)}
            <Icon class="size-5" name="arrow" size={20} />
          </a>
        </section>
      ) : (
        <Card as="section" class="px-6 py-10 text-center text-muted">
          <p class="m-0">{t(I18nKey.noPublishedPosts)}</p>
        </Card>
      )}
    </div>

    <aside
      class="grid grid-cols-1 content-start gap-4 tablet:gap-6 tablet:max-wide:grid-cols-2"
      aria-label={t(I18nKey.siteInformation)}
    >
      <SiteStats stats={stats} title={t(I18nKey.siteOverview)} />
      {popularTags.length > 0 && (
        <PopularTags tags={popularTags} title={t(I18nKey.popularTags)} tagsLabel={t(I18nKey.navigationTags)} />
      )}
      <QuoteCard quote={siteConfig.quote} author={siteConfig.owner} />
    </aside>
  </div>
</BaseLayout>
