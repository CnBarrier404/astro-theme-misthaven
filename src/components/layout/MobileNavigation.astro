---
import HeaderIconButton from "@/components/layout/HeaderIconButton.astro";
import Icon from "@/components/ui/Icon.astro";
import { I18nKey, t } from "@/i18n";
import { anchoredPopoverClass, popoverMotionClass } from "@/utils/motion";
import type { ComponentProps } from "astro/types";

interface NavigationItem {
  href: string;
  label: string;
  icon: ComponentProps<typeof Icon>["name"];
  isActive: boolean;
}

interface Props {
  items: readonly NavigationItem[];
}

const { items } = Astro.props;
const menuId = "mobile-navigation";
---

<HeaderIconButton
  class="wide:hidden"
  name="menu"
  size={18}
  aria-label={t(I18nKey.navigationMenu)}
  popovertarget={menuId}
/>

<nav
  class:list={[
    "w-44 rounded-panel border border-border bg-panel p-1 text-text wide:hidden",
    anchoredPopoverClass,
    popoverMotionClass,
  ]}
  id={menuId}
  aria-label={t(I18nKey.primaryNavigation)}
  data-mobile-navigation
  data-anchored-popover
  popover
>
  {items.map(({ href, label, icon, isActive }) => (
    <a
      class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-sm font-semibold whitespace-nowrap text-text-soft transition-colors hover:bg-accent-soft hover:text-accent-strong focus-visible:bg-accent-soft focus-visible:text-accent-strong focus-visible:outline-hidden aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent-strong"
      href={href}
      aria-current={isActive ? "page" : undefined}
    >
      <Icon name={icon} size={16} />
      <span>{label}</span>
    </a>
  ))}
</nav>
