---
import DraftBadge from "@/components/ui/DraftBadge.astro";
import IconText from "@/components/ui/IconText.astro";
import TagList from "@/components/ui/TagList.astro";
import { isCommentViewCountEnabled } from "@/config/commentConfig";
import { getTranslator, I18nKey } from "@/i18n";
import { formatPostDate, getPostHref, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const t = getTranslator();
const { title, description, publishedAt, category, tags, draft } = post.data;
const href = getPostHref(post);
---

<article class="group relative flex flex-col gap-3 px-5 py-6 tablet:px-8 tablet:py-7">
  <h2 class="m-0 text-lg leading-7 font-semibold tablet:text-post-card-title">
    <!-- The title link stretches over the whole card so the card is one click target. -->
    <a
      class="transition-colors group-hover:text-accent-strong after:absolute after:inset-0 after:rounded-panel focus-visible:outline-hidden focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-focus-ring"
      href={href}
    >
      {title}
    </a>
  </h2>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted" aria-label={t(I18nKey.postInformation)}>
    <IconText icon="calendar">
      <time class="tabular-nums" datetime={publishedAt.toISOString()}>
        {formatPostDate(publishedAt)}
      </time>
    </IconText>
    <IconText icon="folder">{category}</IconText>
    {isCommentViewCountEnabled && (
      <IconText icon="chart">
        <span>
          {t(I18nKey.postViews)}{" "}
          <span class="tabular-nums" aria-live="polite" data-post-card-view-value>
            -
          </span>
        </span>
      </IconText>
    )}
    {draft && <DraftBadge>{t(I18nKey.postDraft)}</DraftBadge>}
  </div>

  <p class="m-0 line-clamp-2 text-sm leading-6 text-text-soft">{description}</p>
  {tags.length > 0 && <TagList tags={tags} ariaLabel={t(I18nKey.postTagsForTitle, { title })} linked />}
</article>
