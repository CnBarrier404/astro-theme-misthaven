---
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import IconText from "@/components/ui/IconText.astro";
import { postConfig } from "@/config/postConfig";
import { getTranslator, I18nKey } from "@/i18n";
import { nudgeBackClass, nudgeForwardClass } from "@/utils/motion";
import { getPostHref, type PostEntry } from "@/utils/posts";

interface Props {
  previousPost?: PostEntry;
  nextPost?: PostEntry;
}

const { previousPost, nextPost } = Astro.props;
const t = getTranslator();
const license = postConfig.license.trim();
const hasNavigation = Boolean(previousPost || nextPost);
---

{(license || hasNavigation) && (
  <div class="mt-4 space-y-4">
    {license && (
      <p class="m-0 px-1 text-sm leading-6 text-muted">
        <IconText icon="cc">{t(I18nKey.postLicense, { license })}</IconText>
      </p>
    )}

    {hasNavigation && (
      <Card as="nav" class="grid grid-cols-2 overflow-hidden" aria-label={t(I18nKey.postNavigation)}>
        {previousPost ? (
          <a
            class="group flex min-h-24 min-w-0 items-center gap-3 border-r border-border px-4 py-4 transition-colors hover:bg-accent-soft focus-visible:-outline-offset-2 tablet:gap-4 tablet:px-6"
            href={getPostHref(previousPost)}
            aria-label={t(I18nKey.postPreviousLink, { title: previousPost.data.title })}
          >
            <Icon class:list={["flex-none rotate-180 text-accent-strong", nudgeBackClass]} name="arrow" size={20} />
            <span class="min-w-0">
              <span class="block text-xs font-medium text-accent-strong">{t(I18nKey.postPrevious)}</span>
              <span class="mt-1 line-clamp-2 block text-sm leading-6 text-text-soft">{previousPost.data.title}</span>
            </span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
        {nextPost ? (
          <a
            class="group flex min-h-24 min-w-0 items-center justify-end gap-3 px-4 py-4 text-right transition-colors hover:bg-accent-soft focus-visible:-outline-offset-2 tablet:gap-4 tablet:px-6"
            href={getPostHref(nextPost)}
            aria-label={t(I18nKey.postNextLink, { title: nextPost.data.title })}
          >
            <span class="min-w-0">
              <span class="block text-xs font-medium text-accent-strong">{t(I18nKey.postNext)}</span>
              <span class="mt-1 line-clamp-2 block text-sm leading-6 text-text-soft">{nextPost.data.title}</span>
            </span>
            <Icon class:list={["flex-none text-accent-strong", nudgeForwardClass]} name="arrow" size={20} />
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
      </Card>
    )}
  </div>
)}
