---
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import IconText from "@/components/ui/IconText.astro";
import { postConfig } from "@/config/postConfig";
import { I18nKey, t } from "@/i18n";
import { nudgeBackClass, nudgeForwardClass } from "@/utils/motion";
import { getPostHref } from "@/utils/paths";
import type { PostEntry } from "@/utils/posts";

interface Props {
  previousPost?: PostEntry;
  nextPost?: PostEntry;
}

const { previousPost, nextPost } = Astro.props;
const license = postConfig.license.trim();
const neighbors = [
  { post: previousPost, label: I18nKey.postPrevious, linkLabel: I18nKey.postPreviousLink, next: false },
  { post: nextPost, label: I18nKey.postNext, linkLabel: I18nKey.postNextLink, next: true },
];
const hasNavigation = neighbors.some(({ post }) => post !== undefined);
---

{(license || hasNavigation) && (
  <div class="mt-4 space-y-4">
    {license && (
      <p class="m-0 px-1 text-sm leading-6 text-muted">
        <IconText icon="cc">{t(I18nKey.postLicense, { license })}</IconText>
      </p>
    )}

    {hasNavigation && (
      <Card as="nav" class="grid grid-cols-1 overflow-hidden tablet:grid-cols-2" aria-label={t(I18nKey.postNavigation)}>
        {neighbors.map(
          ({ post, label, linkLabel, next }) =>
            post && (
              <a
                class:list={[
                  "group flex min-h-24 min-w-0 items-center gap-3 px-4 py-4 transition-colors hover:bg-accent-soft focus-visible:-outline-offset-2 tablet:gap-4 tablet:px-6",
                  next
                    ? "justify-end text-end tablet:col-start-2"
                    : "border-border has-[+a]:border-b tablet:has-[+a]:border-e tablet:has-[+a]:border-b-0",
                ]}
                href={getPostHref(post)}
                aria-label={t(linkLabel, { title: post.data.title })}
              >
                <Icon
                  class:list={[
                    "flex-none text-accent-strong",
                    next ? ["order-last", nudgeForwardClass] : ["rotate-180", nudgeBackClass],
                  ]}
                  name="arrow"
                  size={20}
                />
                <span class="min-w-0">
                  <span class="block text-xs font-medium text-accent-strong">{t(label)}</span>
                  <span class="mt-1 line-clamp-2 block text-sm leading-6 text-text-soft">{post.data.title}</span>
                </span>
              </a>
            ),
        )}
      </Card>
    )}
  </div>
)}
