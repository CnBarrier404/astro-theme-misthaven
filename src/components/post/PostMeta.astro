---
import IconBadge from "@/components/ui/IconBadge.astro";
import { isCommentViewCountEnabled } from "@/config/commentConfig";
import { getTranslator, I18nKey } from "@/i18n";

interface Props {
  wordCount: string;
  readingTime: string;
  pageKey: string;
}

const { wordCount, readingTime, pageKey } = Astro.props;
const t = getTranslator();
---

<div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
  <span class="inline-flex items-center gap-2">
    <IconBadge icon="menu" size="sm" tone="neutral" />
    {wordCount}
  </span>
  <span class="inline-flex items-center gap-2">
    <IconBadge icon="clock" size="sm" tone="neutral" />
    {readingTime}
  </span>
  {isCommentViewCountEnabled && (
    <span class="inline-flex items-center gap-2" data-page-key={pageKey} data-post-view data-view-placeholder="-">
      <IconBadge icon="chart" size="sm" tone="neutral" />
      <span>
        {t(I18nKey.postViews)}{" "}
        <span aria-live="polite" data-post-view-value>
          -
        </span>
      </span>
    </span>
  )}
</div>
