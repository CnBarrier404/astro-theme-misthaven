---
import IconText from "@/components/ui/IconText.astro";
import { isCommentViewCountEnabled } from "@/config/commentConfig";
import { getTranslator, I18nKey } from "@/i18n";
import { formatPostDate } from "@/utils/posts";

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  category: string;
  wordCount: string;
  readingTime: string;
  pageKey: string;
  class?: string;
}

const { publishedAt, updatedAt, category, wordCount, readingTime, pageKey, class: className } = Astro.props;
const t = getTranslator();
---

<div
  class:list={["flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted", className]}
  aria-label={t(I18nKey.postInformation)}
>
  <IconText icon="calendar">
    <time class="tabular-nums" datetime={publishedAt.toISOString()}>
      {formatPostDate(publishedAt)}
    </time>
  </IconText>
  {updatedAt && (
    <IconText icon="history">
      <time class="tabular-nums" datetime={updatedAt.toISOString()}>
        {t(I18nKey.postUpdatedAt, { date: formatPostDate(updatedAt) })}
      </time>
    </IconText>
  )}
  <IconText icon="folder">{category}</IconText>
  <IconText icon="menu">{wordCount}</IconText>
  <IconText icon="clock">{readingTime}</IconText>
  {isCommentViewCountEnabled && (
    <IconText icon="chart">
      <span data-page-key={pageKey} data-post-view data-view-placeholder="-">
        {t(I18nKey.postViews)}{" "}
        <span class="tabular-nums" aria-live="polite" data-post-view-value>
          -
        </span>
      </span>
    </IconText>
  )}
</div>
