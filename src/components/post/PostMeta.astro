---
import { viewCountPlaceholder } from "@/components/comments/viewCounts";
import IconText from "@/components/ui/IconText.astro";
import { postConfig } from "@/config/postConfig";
import { I18nKey, t } from "@/i18n";
import { formatPostDate } from "@/utils/postDates";
import { countPostWords, type PostEntry } from "@/utils/posts";

interface Props {
  post: PostEntry;
  viewCountId?: string;
  class?: string;
}

const { post, viewCountId, class: className } = Astro.props;
const { publishedAt, updatedAt, category } = post.data;
const wordCount = countPostWords(post);
const minutes = Math.max(1, Math.ceil(wordCount / postConfig.readingUnitsPerMinute));
---

<div
  class:list={["flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted", className]}
  aria-label={t(I18nKey.postInformation)}
>
  <IconText icon="calendar">
    <time class="tabular-nums" datetime={publishedAt.toISOString()}>
      {formatPostDate(publishedAt)}
    </time>
  </IconText>
  {updatedAt && (
    <IconText icon="history">
      <time class="tabular-nums" datetime={updatedAt.toISOString()}>
        {t(I18nKey.postUpdatedAt, { date: formatPostDate(updatedAt) })}
      </time>
    </IconText>
  )}
  <IconText icon="folder">{category}</IconText>
  <IconText icon="menu">{t(I18nKey.postWordCount, { count: wordCount })}</IconText>
  <IconText icon="clock">{t(I18nKey.postReadingTime, { minutes })}</IconText>
  {viewCountId && (
    <IconText icon="chart">
      <span>
        {t(I18nKey.postViews)}{" "}
        <span class="artalk-pv-count tabular-nums" id={viewCountId} aria-live="polite">
          {viewCountPlaceholder}
        </span>
      </span>
    </IconText>
  )}
</div>
