---
import Icon from "@/components/ui/Icon.astro";
import { getTranslator, I18nKey } from "@/i18n";
import { formatPostDate } from "@/utils/posts";

interface Props {
  lastUpdatedAt: Date;
  thresholdDays: number;
}

const millisecondsPerDay = 86_400_000;
const { lastUpdatedAt, thresholdDays } = Astro.props;
const normalizedThresholdDays = Math.max(1, Math.floor(thresholdDays));
const elapsedDays = Math.max(0, Math.floor((Date.now() - lastUpdatedAt.getTime()) / millisecondsPerDay));
const formattedDate = formatPostDate(lastUpdatedAt);
const t = getTranslator();
const summaryTemplate = t(I18nKey.postOutdatedSummary, { date: formattedDate, days: "{days}" });
---

<aside
  class="mt-6 flex items-center gap-2 rounded-panel bg-warning-soft px-6 py-6"
  data-post-outdated-warning
  data-last-updated-at={lastUpdatedAt.toISOString()}
  data-summary-template={summaryTemplate}
  data-threshold-days={normalizedThresholdDays}
  hidden={elapsedDays < normalizedThresholdDays}
  role="note"
>
  <span class="grid size-9 flex-none place-items-center rounded-md bg-panel text-warning" aria-hidden="true">
    <Icon name="history" size={18} />
  </span>
  <span class="min-w-0">
    <span class="block text-base leading-5" data-post-outdated-summary>
      {t(I18nKey.postOutdatedSummary, { date: formattedDate, days: elapsedDays })}
    </span>
    <span class="block text-sm leading-4">{t(I18nKey.postOutdatedDescription)}</span>
  </span>
</aside>

<script>
  const millisecondsPerDay = 86_400_000;

  const updatePostOutdatedWarnings = () => {
    document.querySelectorAll<HTMLElement>("[data-post-outdated-warning]").forEach((warning) => {
      const lastUpdatedAt = Date.parse(warning.dataset.lastUpdatedAt ?? "");
      const thresholdDays = Number(warning.dataset.thresholdDays);

      if (!Number.isFinite(lastUpdatedAt) || !Number.isFinite(thresholdDays)) return;

      const elapsedDays = Math.max(0, Math.floor((Date.now() - lastUpdatedAt) / millisecondsPerDay));
      const summary = warning.querySelector<HTMLElement>("[data-post-outdated-summary]");

      warning.hidden = elapsedDays < thresholdDays;
      if (summary) summary.textContent = (warning.dataset.summaryTemplate ?? "").replace("{days}", String(elapsedDays));
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", updatePostOutdatedWarnings, { once: true });
  } else {
    updatePostOutdatedWarnings();
  }

  document.addEventListener("astro:page-load", updatePostOutdatedWarnings);
</script>
