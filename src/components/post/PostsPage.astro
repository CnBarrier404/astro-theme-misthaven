---
import PostList from "@/components/post/PostList.astro";
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import PostSort from "@/components/post/PostSort.astro";
import { siteConfig } from "@/config/siteConfig";
import { getTranslator, I18nKey } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getVisiblePosts } from "@/utils/posts";

const posts = await getVisiblePosts();
const t = getTranslator();
const pageDescription = t(I18nKey.postsPageDescription, { owner: siteConfig.owner });
---

<BaseLayout title={`${t(I18nKey.navigationPosts)} · ${siteConfig.title}`} description={pageDescription}>
  <div class="mx-auto w-full max-w-post">
    <PageHeader title={t(I18nKey.navigationPosts)} intro={t(I18nKey.postsPageIntro)}>
      <div class="flex flex-none items-center gap-4">
        <p class="m-0 text-sm text-muted">{t(I18nKey.postsCount, { count: posts.length })}</p>
        <PostSort targetId="posts-page-list" />
      </div>
    </PageHeader>

    {posts.length > 0 ? (
      <PostList class="mt-4 tablet:mt-5" id="posts-page-list" posts={posts} ariaLabel={t(I18nKey.postsList)} />
    ) : (
      <Card class="mt-4 grid justify-items-center gap-3 px-6 py-12 text-center text-muted tablet:mt-5">
        <Icon name="article" size={28} />
        <p class="m-0">{t(I18nKey.noPublishedPosts)}</p>
      </Card>
    )}
  </div>
</BaseLayout>
