---
interface Props {
  depth: number;
  slug: string;
  text: string;
  sectionIndex?: number;
  /** Tracked links drive the active-section indicator of the sidebar table of contents. */
  tracked?: boolean;
}

const { depth, slug, text, sectionIndex, tracked = false } = Astro.props;
---

<li>
  <a
    class:list={[
      "relative z-10 flex min-w-0 items-baseline gap-2 rounded-panel py-2 pr-2 text-sm leading-5 text-text-soft transition-colors hover:text-accent-strong",
      depth === 2 && "pl-2",
      depth === 3 && "pl-8",
      depth === 4 && "pl-12",
    ]}
    href={`#${slug}`}
    data-toc-link={tracked ? "" : undefined}
  >
    {depth === 2 && <span class="w-4 shrink-0 text-xs text-muted tabular-nums">{sectionIndex}</span>}
    <span class="min-w-0 truncate">{text}</span>
  </a>
</li>
