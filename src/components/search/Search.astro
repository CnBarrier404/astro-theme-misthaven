---
import SearchBox from "@/components/search/SearchBox.astro";
import Icon from "@/components/ui/Icon.astro";
import { getTranslator, I18nKey } from "@/i18n";

const t = getTranslator();
const dialogId = "mobile-search-dialog";
---

<SearchBox class="hidden min-w-0 tablet:block" id="site-search" variant="popover" />

<button
  class="grid size-10 flex-none cursor-pointer place-items-center rounded-panel border border-border bg-surface/90 text-text-soft transition-colors hover:border-border-strong hover:text-accent-strong tablet:hidden"
  type="button"
  aria-label={t(I18nKey.searchLabel)}
  aria-haspopup="dialog"
  aria-controls={dialogId}
  data-search-dialog-open
>
  <Icon name="search" size={16} />
</button>

<dialog
  class="m-0 w-full max-w-none -translate-y-2 border-0 bg-transparent p-0 text-text opacity-0 transition transition-discrete duration-200 ease-soft backdrop:bg-overlay backdrop:opacity-0 backdrop:transition backdrop:transition-discrete backdrop:duration-200 open:translate-y-0 open:opacity-100 open:backdrop:opacity-100 starting:open:-translate-y-2 starting:open:opacity-0 starting:open:backdrop:opacity-0"
  id={dialogId}
  aria-label={t(I18nKey.searchLabel)}
  data-search-dialog
>
  <div class="border-b border-border bg-page px-4 py-3">
    <SearchBox id="mobile-search" variant="sheet">
      <button
        class="grid size-11 flex-none cursor-pointer place-items-center rounded-panel text-text-soft transition-colors hover:bg-accent-soft hover:text-accent-strong"
        type="button"
        aria-label={t(I18nKey.searchClose)}
        data-search-dialog-close
      >
        <Icon name="close" size={18} />
      </button>
    </SearchBox>
  </div>
</dialog>

<script>
  const isHidden = (element: HTMLElement) => getComputedStyle(element).display === "none";

  const setupSearchDialogs = () => {
    document.querySelectorAll<HTMLDialogElement>("[data-search-dialog]").forEach((dialog) => {
      if (dialog.dataset.searchDialogReady) return;
      dialog.dataset.searchDialogReady = "true";

      const trigger = document.querySelector<HTMLButtonElement>(
        `[data-search-dialog-open][aria-controls="${CSS.escape(dialog.id)}"]`,
      );

      trigger?.addEventListener("click", () => dialog.showModal());
      dialog.querySelector("[data-search-dialog-close]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        // Clicks on the backdrop target the dialog itself.
        if (event.target === dialog) dialog.close();
      });
    });
  };

  // The dialog is a mobile-only surface; close it when the layout grows past the trigger's breakpoint.
  window.addEventListener(
    "resize",
    () => {
      document.querySelectorAll<HTMLDialogElement>("[data-search-dialog][open]").forEach((dialog) => {
        const trigger = document.querySelector<HTMLElement>(`[aria-controls="${CSS.escape(dialog.id)}"]`);
        if (trigger && isHidden(trigger)) dialog.close();
      });
    },
    { passive: true },
  );

  setupSearchDialogs();
  document.addEventListener("astro:page-load", setupSearchDialogs);
</script>
