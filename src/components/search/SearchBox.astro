---
import Icon from "@/components/ui/Icon.astro";
import { I18nKey, t } from "@/i18n";
import { dropdownMotionClass } from "@/utils/motion";

interface Props {
  id: string;
  variant: "field" | "sheet";
  class?: string;
}

const { id, variant, class: className } = Astro.props;
const inputId = `${id}-input`;
const resultsId = `${id}-results`;
const isSheet = variant === "sheet";
---

<site-search
  id={id}
  class:list={[isSheet ? "flex flex-wrap items-center gap-2" : "relative", className]}
  data-search-prompt={t(I18nKey.searchPrompt)}
  data-search-loading={t(I18nKey.searchLoading)}
  data-search-count={t(I18nKey.searchCount, { count: "{count}" })}
  data-search-empty={t(I18nKey.searchEmpty)}
  data-search-error={t(I18nKey.searchError)}
>
  <div
    class:list={[
      "flex items-center gap-2 rounded-panel border border-border bg-surface/90 px-3 text-text-soft transition focus-within:border-focus-ring/40 focus-within:ring-3 focus-within:ring-focus-ring/10",
      isSheet ? "h-11 min-w-0 flex-1" : "h-10 w-72 max-w-full",
    ]}
  >
    <label class="sr-only" for={inputId}>
      {t(I18nKey.searchLabel)}
    </label>
    <Icon name="search" size={16} />
    <input
      class="w-full min-w-0 border-0 bg-transparent p-0 text-sm placeholder:text-muted focus-visible:outline-hidden"
      id={inputId}
      type="text"
      placeholder={t(I18nKey.searchPlaceholder)}
      autofocus={isSheet}
      autocomplete="off"
      enterkeyhint="search"
      role="combobox"
      aria-autocomplete="list"
      aria-controls={resultsId}
      aria-expanded="false"
    />
    <button
      class="grid size-7 shrink-0 cursor-pointer place-items-center rounded-md text-accent-strong transition-colors hover:bg-accent-soft focus-visible:bg-accent-soft focus-visible:outline-hidden"
      type="button"
      aria-label={t(I18nKey.searchClear)}
      data-search-clear
      hidden
    >
      <Icon name="close" size={16} strokeWidth={2.4} />
    </button>
  </div>

  <slot />

  <div
    class:list={[
      "overflow-hidden rounded-panel border border-border bg-surface",
      dropdownMotionClass,
      isSheet ? "w-full" : "absolute top-full left-1/2 z-50 mt-2 w-112 -translate-x-1/2",
    ]}
    data-search-panel
  >
    <p class="m-0 px-4 py-3 text-sm text-muted" data-search-status aria-live="polite">
      {t(I18nKey.searchPrompt)}
    </p>
    <ul
      class="max-h-96 overflow-y-auto border-t border-border p-2 transition-opacity duration-200 ease-soft starting:opacity-0"
      id={resultsId}
      role="listbox"
      hidden
    ></ul>
  </div>
  <template>
    <li role="option">
      <a
        class="block rounded-panel px-3 py-3 transition-colors hover:bg-accent-soft focus:bg-accent-soft focus:outline-hidden in-aria-selected:bg-accent-soft"
        tabindex="-1"
      >
        <span class="block text-sm font-semibold text-text" data-result-title></span>
        <span class="mt-1 line-clamp-2 block text-sm leading-6 text-text-soft" data-result-description></span>
        <span class="mt-2 flex items-center gap-2 text-xs text-muted">
          <span class="rounded-panel bg-accent-soft px-2 py-1 text-accent-strong" data-result-category></span>
          <time data-result-date></time>
        </span>
      </a>
    </li>
  </template>
</site-search>

<script>
  import "./siteSearch";
</script>
