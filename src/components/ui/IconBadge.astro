---
import Icon from "@/components/ui/Icon.astro";
import type { ComponentProps } from "astro/types";

interface Props {
  /** Icon to render. Omit it to render the default slot, such as a short glyph. */
  icon?: ComponentProps<typeof Icon>["name"];
  iconSize?: number;
  size?: keyof typeof sizeClasses;
  tone?: keyof typeof toneClasses;
  class?: string;
}

const sizeClasses = {
  sm: "size-7",
  md: "size-8",
} as const;

const toneClasses = {
  accent: "bg-accent-soft text-accent-strong",
  neutral: "bg-border/50",
} as const;

const { icon, iconSize = 16, size = "md", tone = "accent", class: className } = Astro.props;
---

<span class:list={["grid flex-none place-items-center rounded-md", sizeClasses[size], toneClasses[tone], className]}>
  {icon ? <Icon name={icon} size={iconSize} /> : <slot />}
</span>
