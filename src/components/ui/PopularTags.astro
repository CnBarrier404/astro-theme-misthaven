---
import Card from "@/components/ui/Card.astro";
import TagList from "@/components/ui/TagList.astro";

interface Props {
  tags: readonly string[];
  title: string;
  tagsLabel: string;
}

const { tags, title, tagsLabel } = Astro.props;
---

<Card as="section" class="px-6 py-5 tablet:p-8" aria-labelledby="tags-title">
  <h2 class="m-0 text-sm font-bold tablet:text-base" id="tags-title">
    {title}
  </h2>
  <TagList class="mt-4" tags={tags} variant="popular" ariaLabel={tagsLabel} />
</Card>
