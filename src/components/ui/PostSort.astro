---
import Icon from "@/components/ui/Icon.astro";
import { isCommentViewCountEnabled } from "@/config/commentConfig";
import { getTranslator, I18nKey } from "@/i18n";

interface Props {
  targetId: string;
}

const { targetId } = Astro.props;
const t = getTranslator();
const menuId = `${targetId}-sort-menu`;
---

<div class="relative flex-none" data-post-sort data-post-sort-mode="latest" data-post-sort-target={targetId}>
  <button
    class="inline-flex h-10 cursor-pointer items-center gap-2 rounded-lg border border-border bg-panel px-4 text-sm text-text-soft transition-colors hover:border-border-strong"
    type="button"
    aria-label={t(I18nKey.postSort)}
    aria-controls={menuId}
    aria-expanded="false"
    data-post-sort-trigger
  >
    <span data-post-sort-current>{t(I18nKey.sortLatest)}</span>
    <Icon class="size-4 rotate-90 text-muted transition-transform duration-150 ease-out" name="chevron" size={16} />
  </button>

  <div
    class="pointer-events-none absolute top-full right-0 z-10 mt-2 w-max min-w-full -translate-y-1 rounded-lg border border-border bg-panel p-1 opacity-0 transition-[opacity,transform] duration-150 ease-out"
    id={menuId}
    hidden
    data-post-sort-menu
  >
    <button
      class="flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-2 text-left text-sm whitespace-nowrap text-text-soft transition-colors hover:bg-accent-soft hover:text-accent-strong aria-pressed:text-accent-strong"
      type="button"
      aria-pressed="true"
      data-post-sort-label={t(I18nKey.sortLatest)}
      data-post-sort-option="latest"
    >
      <span class="grid size-4 shrink-0 place-items-center text-accent-strong" aria-hidden="true" data-post-sort-check>
        <Icon class="size-3.5" name="check" size={14} />
      </span>
      <span>{t(I18nKey.sortLatest)}</span>
    </button>
    {isCommentViewCountEnabled && (
      <button
        class="flex w-full cursor-pointer items-center gap-2 rounded-md px-3 py-2 text-left text-sm whitespace-nowrap text-text-soft transition-colors hover:bg-accent-soft hover:text-accent-strong aria-pressed:text-accent-strong"
        type="button"
        aria-pressed="false"
        data-post-sort-label={t(I18nKey.sortMostRead)}
        data-post-sort-option="views"
      >
        <span
          class="grid size-4 shrink-0 place-items-center text-accent-strong opacity-0 transition-opacity duration-150"
          aria-hidden="true"
          data-post-sort-check
        >
          <Icon class="size-3.5" name="check" size={14} />
        </span>
        <span>{t(I18nKey.sortMostRead)}</span>
      </button>
    )}
  </div>
</div>

<script>
  type SortMode = "latest" | "views";
  type ViewCounts = Record<string, number>;

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const activeItemAnimations = new WeakMap<HTMLElement, Animation>();
  const postSortMenuCloseTimers = new WeakMap<HTMLElement, number>();
  const postSortMenuOpenFrames = new WeakMap<HTMLElement, number>();
  const postSortMenuClosedClasses = ["-translate-y-1", "opacity-0", "pointer-events-none"];
  const postSortMenuOpenClasses = ["translate-y-0", "opacity-100", "pointer-events-auto"];

  const getNumericData = (item: HTMLElement, key: "publishedAt" | "viewCount") => {
    return Number(item.dataset[key] ?? 0);
  };

  const cancelItemAnimations = (items: HTMLElement[]) => {
    items.forEach((item) => {
      activeItemAnimations.get(item)?.cancel();
      activeItemAnimations.delete(item);
    });
  };

  const getVisibleItemPositions = (items: HTMLElement[]) => {
    return new Map(items.filter((item) => !item.hidden).map((item) => [item, item.getBoundingClientRect()]));
  };

  const animatePostItems = (items: HTMLElement[], previousPositions: Map<HTMLElement, DOMRect>) => {
    if (reducedMotion.matches) return;

    items.forEach((item) => {
      if (item.hidden) return;

      const previousPosition = previousPositions.get(item);
      const currentPosition = item.getBoundingClientRect();
      const keyframes = previousPosition
        ? [
            {
              transform: `translate(${previousPosition.left - currentPosition.left}px, ${previousPosition.top - currentPosition.top}px)`,
            },
            { transform: "translate(0, 0)" },
          ]
        : [
            { opacity: 0, transform: "translateY(8px)" },
            { opacity: 1, transform: "translateY(0)" },
          ];

      if (
        previousPosition &&
        previousPosition.left === currentPosition.left &&
        previousPosition.top === currentPosition.top
      ) {
        return;
      }

      const animation = item.animate(keyframes, { duration: 200, easing: "ease-out" });
      activeItemAnimations.set(item, animation);
      animation.finished
        .then(() => {
          if (activeItemAnimations.get(item) === animation) activeItemAnimations.delete(item);
        })
        .catch(() => {});
    });
  };

  const sortPostList = (sort: HTMLElement) => {
    const targetId = sort.dataset.postSortTarget;
    const list = targetId ? document.getElementById(targetId) : null;

    if (!(list instanceof HTMLOListElement)) return;

    const mode = (sort.dataset.postSortMode ?? "latest") as SortMode;
    const items = [...list.querySelectorAll<HTMLElement>("[data-post-list-item]")];
    const limit = Number(list.dataset.limit ?? items.length);
    cancelItemAnimations(items);
    const previousPositions = getVisibleItemPositions(items);

    items.sort((left, right) => {
      if (mode === "views") {
        const viewDifference = getNumericData(right, "viewCount") - getNumericData(left, "viewCount");
        if (viewDifference !== 0) return viewDifference;
      }

      const dateDifference = getNumericData(right, "publishedAt") - getNumericData(left, "publishedAt");
      return dateDifference || (left.dataset.postPath ?? "").localeCompare(right.dataset.postPath ?? "");
    });

    items.forEach((item, index) => {
      item.hidden = index >= limit;
      list.append(item);
    });

    animatePostItems(items, previousPositions);
  };

  const closePostSort = (sort: HTMLElement) => {
    const trigger = sort.querySelector<HTMLButtonElement>("[data-post-sort-trigger]");
    const menu = sort.querySelector<HTMLElement>("[data-post-sort-menu]");
    const icon = trigger?.querySelector<SVGElement>("svg");

    if (!trigger || !menu) return;

    const closeTimer = postSortMenuCloseTimers.get(menu);
    if (closeTimer !== undefined) {
      window.clearTimeout(closeTimer);
      postSortMenuCloseTimers.delete(menu);
    }

    const openFrame = postSortMenuOpenFrames.get(menu);
    if (openFrame !== undefined) {
      window.cancelAnimationFrame(openFrame);
      postSortMenuOpenFrames.delete(menu);
    }

    trigger.setAttribute("aria-expanded", "false");
    menu.classList.remove(...postSortMenuOpenClasses);
    menu.classList.add(...postSortMenuClosedClasses);
    icon?.classList.remove("-rotate-90");
    icon?.classList.add("rotate-90");

    if (menu.hidden) return;

    const timer = window.setTimeout(() => {
      if (trigger.getAttribute("aria-expanded") === "false") menu.hidden = true;
      postSortMenuCloseTimers.delete(menu);
    }, 150);
    postSortMenuCloseTimers.set(menu, timer);
  };

  const openPostSort = (sort: HTMLElement) => {
    const trigger = sort.querySelector<HTMLButtonElement>("[data-post-sort-trigger]");
    const menu = sort.querySelector<HTMLElement>("[data-post-sort-menu]");
    const icon = trigger?.querySelector<SVGElement>("svg");

    if (!trigger || !menu) return;

    const closeTimer = postSortMenuCloseTimers.get(menu);
    if (closeTimer !== undefined) {
      window.clearTimeout(closeTimer);
      postSortMenuCloseTimers.delete(menu);
    }

    const openFrame = postSortMenuOpenFrames.get(menu);
    if (openFrame !== undefined) window.cancelAnimationFrame(openFrame);

    trigger.setAttribute("aria-expanded", "true");
    menu.hidden = false;
    menu.classList.remove(...postSortMenuOpenClasses);
    menu.classList.add(...postSortMenuClosedClasses);
    icon?.classList.remove("rotate-90");
    icon?.classList.add("-rotate-90");

    const frame = window.requestAnimationFrame(() => {
      if (menu.hidden || trigger.getAttribute("aria-expanded") !== "true") return;

      menu.classList.remove(...postSortMenuClosedClasses);
      menu.classList.add(...postSortMenuOpenClasses);
      postSortMenuOpenFrames.delete(menu);
    });
    postSortMenuOpenFrames.set(menu, frame);
  };

  const setupPostSort = () => {
    document.querySelectorAll<HTMLElement>("[data-post-sort]").forEach((sort) => {
      if (sort.dataset.postSortReady) return;

      const trigger = sort.querySelector<HTMLButtonElement>("[data-post-sort-trigger]");
      const menu = sort.querySelector<HTMLElement>("[data-post-sort-menu]");
      const current = sort.querySelector<HTMLElement>("[data-post-sort-current]");
      const options = sort.querySelectorAll<HTMLButtonElement>("[data-post-sort-option]");

      if (!trigger || !menu || !current) return;

      sort.dataset.postSortReady = "true";
      trigger.addEventListener("click", () => {
        const shouldOpen = trigger.getAttribute("aria-expanded") !== "true";
        document.querySelectorAll<HTMLElement>("[data-post-sort]").forEach(closePostSort);
        if (shouldOpen) openPostSort(sort);
      });

      options.forEach((option) => {
        option.addEventListener("click", () => {
          const mode = (option.dataset.postSortOption ?? "latest") as SortMode;
          sort.dataset.postSortMode = mode;
          current.textContent = option.dataset.postSortLabel ?? option.textContent?.trim() ?? "";

          options.forEach((candidate) => {
            candidate.setAttribute("aria-pressed", String(candidate === option));
            candidate
              .querySelector<HTMLElement>("[data-post-sort-check]")
              ?.classList.toggle("opacity-0", candidate !== option);
          });

          sortPostList(sort);
          closePostSort(sort);
        });
      });
    });
  };

  document.addEventListener("pointerdown", (event) => {
    const target = event.target;

    document.querySelectorAll<HTMLElement>("[data-post-sort]").forEach((sort) => {
      if (!(target instanceof Node) || !sort.contains(target)) closePostSort(sort);
    });
  });

  document.addEventListener("post-view-counts", (event) => {
    const counts = (event as CustomEvent<{ counts?: ViewCounts }>).detail?.counts;
    if (!counts) return;

    document.querySelectorAll<HTMLElement>("[data-post-list-item]").forEach((item) => {
      const path = item.dataset.postPath;
      const count = path ? counts[path] : undefined;
      if (typeof count !== "number" || !Number.isFinite(count)) return;

      item.dataset.viewCount = String(count);
      const value = item.querySelector<HTMLElement>("[data-post-card-view-value]");
      if (value) value.textContent = count > 0 ? String(count) : "-";
    });

    document.querySelectorAll<HTMLElement>("[data-post-sort]").forEach((sort) => {
      if (sort.dataset.postSortMode === "views") sortPostList(sort);
    });
  });

  setupPostSort();
  document.addEventListener("astro:page-load", setupPostSort);
</script>
