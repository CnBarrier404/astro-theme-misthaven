---
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import type { SiteStat } from "@/types/home";

interface Props {
  stats: readonly SiteStat[];
  title: string;
}

const { stats, title } = Astro.props;
const iconThemes = ["bg-accent-soft text-accent", "bg-special-soft text-special", "bg-info-soft text-info"];
---

<Card as="section" class="px-6 py-5 tablet:p-8" aria-labelledby="stats-title">
  <h2 class="m-0 text-sm font-bold tablet:text-base" id="stats-title">
    {title}
  </h2>
  <div class="mt-5 grid grid-cols-3 gap-2 tablet:mt-6">
    {stats.map((stat, index) => (
      <div class="text-center">
        <span
          class:list={[
            "mx-auto mb-2 grid size-8 place-items-center rounded-panel tablet:size-9",
            iconThemes[index % iconThemes.length],
          ]}
        >
          <Icon class="size-4 tablet:size-5" name={stat.icon} size={16} />
        </span>
        <strong class="block text-base font-bold tablet:text-lg">{stat.value}</strong>
        <small class="mt-1 block text-xs text-muted">{stat.label}</small>
      </div>
    ))}
  </div>
</Card>
