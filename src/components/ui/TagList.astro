---
import { getTagHref } from "@/utils/paths";

interface Props {
  tags: readonly string[];
  ariaLabel: string;
  class?: string;
}

const { tags, ariaLabel, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap gap-2", className]} aria-label={ariaLabel}>
  {tags.map((tag) => (
    <a
      class="inline-flex min-h-6 items-center rounded-md bg-border/50 px-2 text-xs text-muted transition-colors hover:bg-accent-soft hover:text-accent-strong tablet:min-h-7 tablet:px-3 tablet:text-sm"
      href={getTagHref(tag)}
    >
      {tag}
    </a>
  ))}
</div>
