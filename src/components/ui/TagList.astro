---
import { getTagHref } from "@/utils/posts";

interface Props {
  tags: readonly string[];
  ariaLabel: string;
  /** Links each tag to its `/tags/<tag>` page. */
  linked?: boolean;
  class?: string;
}

const { tags, ariaLabel, linked = false, class: className } = Astro.props;
const Tag = linked ? "a" : "span";
---

<div class:list={["flex flex-wrap gap-2", className]} aria-label={ariaLabel}>
  {tags.map((tag) => (
    <Tag
      class:list={[
        "inline-flex min-h-6 items-center rounded-md bg-border/50 px-2 text-xs text-muted tablet:min-h-7 tablet:px-3 tablet:text-sm",
        // `relative z-10` lifts tag links above the stretched title link of `PostCard`.
        linked && "relative z-10 transition-colors hover:bg-accent-soft hover:text-accent-strong",
      ]}
      href={linked ? getTagHref(tag) : undefined}
    >
      {tag}
    </Tag>
  ))}
</div>
