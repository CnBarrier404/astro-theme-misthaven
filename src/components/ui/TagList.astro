---
interface Props {
  tags: readonly string[];
  linked?: boolean;
  variant?: keyof typeof variantClasses;
  ariaLabel: string;
  basePath?: string;
  class?: string;
}

const variantClasses = {
  default: "bg-border/50 font-normal text-muted",
  popular: "bg-special-soft font-semibold text-special",
} as const;

const { tags, linked = false, variant = "default", ariaLabel, basePath = "/tags", class: className } = Astro.props;
const normalizedBasePath = basePath.replace(/\/$/, "");
const Tag = linked ? "a" : "span";
---

<div class:list={["flex flex-wrap gap-2", className]} aria-label={ariaLabel}>
  {tags.map((tag) => (
    <Tag
      class:list={[
        "inline-flex min-h-6 items-center rounded-panel px-2 py-0.5 text-xs tablet:min-h-7 tablet:px-3 tablet:py-1 tablet:text-sm",
        variantClasses[variant],
        linked && "transition-colors hover:bg-accent-soft hover:text-accent-strong",
      ]}
      href={linked ? `${normalizedBasePath}/${encodeURIComponent(tag)}` : undefined}
    >
      {tag}
    </Tag>
  ))}
</div>
