---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { class: className, ...attributes } = Astro.props;
---

<a
  {...attributes}
  class:list={[
    "inline-flex items-center gap-2 text-sm font-semibold text-accent-strong decoration-link-underline underline-offset-4 hover:underline",
    className,
  ]}
>
  <slot />
</a>
