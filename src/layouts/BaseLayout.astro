---
import Footer from "@/components/layout/Footer.astro";
import NavigationBar from "@/components/layout/NavigationBar.astro";
import SeoHead from "@/components/layout/SeoHead.astro";
import SiteFonts from "@/components/layout/SiteFonts.astro";
import ThemeHead from "@/components/layout/ThemeHead.astro";
import { siteConfig } from "@/config/siteConfig";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof SeoHead>;
const faviconLinks = siteConfig.favicon.filter(({ src }) => src.trim());
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ThemeHead />
    <SeoHead {...Astro.props} />
    <SiteFonts />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.title}
      href={new URL("rss.xml", siteConfig.siteUrl)}
    />
    {faviconLinks.map(({ src, sizes, rel, type }) => (
      <link href={src.trim()} sizes={sizes} rel={rel} type={type} />
    ))}
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <NavigationBar />

      <main
        class="mx-auto mt-1 w-layout-width max-w-page flex-1 pb-12 tablet:mt-2 tablet:w-layout-width-tablet tablet:pb-16 wide:w-layout-width-wide"
        data-page-content
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  import "@/components/layout/popovers";
</script>
