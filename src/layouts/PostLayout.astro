---
import CommentSection from "@/components/comments/CommentSection.astro";
import PostEndMatter from "@/components/post/PostEndMatter.astro";
import PostFloatingActions from "@/components/post/PostFloatingActions.astro";
import PostMeta from "@/components/post/PostMeta.astro";
import PostOutdatedWarning from "@/components/post/PostOutdatedWarning.astro";
import Spoiler from "@/components/post/Spoiler.astro";
import TableOfContents from "@/components/post/TableOfContents.astro";
import Card from "@/components/ui/Card.astro";
import DraftBadge from "@/components/ui/DraftBadge.astro";
import TagList from "@/components/ui/TagList.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { postConfig } from "@/config/postConfig";
import { siteConfig } from "@/config/siteConfig";
import { getTranslator, I18nKey } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostHref, getPostMetrics, getPostOgImageHref } from "@/utils/posts";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  headings: MarkdownHeading[];
  previousPost?: CollectionEntry<"posts">;
  nextPost?: CollectionEntry<"posts">;
}

const { post, headings, previousPost, nextPost } = Astro.props;
const t = getTranslator();
const { title, description, publishedAt, updatedAt, category, tags, draft } = post.data;
const { wordCount, readingTime } = getPostMetrics(post);
const pageKey = getPostHref(post);
---

<BaseLayout
  title={`${title} · ${siteConfig.title}`}
  description={description}
  ogImage={{
    src: getPostOgImageHref(post),
    width: 1200,
    height: 630,
    alt: `${title} · ${siteConfig.title}`,
  }}
>
  <PostFloatingActions />
  <Spoiler />

  <div class="mx-auto w-full max-w-reading wide:flex wide:max-w-chrome wide:items-start wide:justify-center wide:gap-8">
    <div class="hidden w-sidebar shrink-0 wide:block" aria-hidden="true"></div>

    <div class="w-full max-w-reading min-w-0">
      <TextLink class="mb-4 ml-1" href="/posts">
        {t(I18nKey.backToPosts)}
      </TextLink>

      <Card as="article" class="w-full overflow-hidden" data-reading-content>
        <header class="border-b border-border px-5 py-8 tablet:px-12 tablet:py-10">
          <h1 class="m-0 text-3xl leading-tight font-semibold tablet:text-4xl">{title}</h1>

          <PostMeta
            class="mt-4"
            publishedAt={publishedAt}
            updatedAt={updatedAt}
            category={category}
            wordCount={wordCount}
            readingTime={readingTime}
            pageKey={pageKey}
          />

          {(tags.length > 0 || draft) && (
            <div class="mt-4 flex flex-wrap items-center gap-2">
              {tags.length > 0 && <TagList tags={tags} ariaLabel={t(I18nKey.postTagsForTitle, { title })} linked />}
              {draft && <DraftBadge>{t(I18nKey.postDraftPreview)}</DraftBadge>}
            </div>
          )}

          {postConfig.outdatedWarning.enabled && (
            <PostOutdatedWarning
              lastUpdatedAt={updatedAt ?? publishedAt}
              thresholdDays={postConfig.outdatedWarning.days}
            />
          )}
        </header>

        <TableOfContents headings={headings} variant="inline" />

        <div class="prose-content px-5 py-8 tablet:px-12 tablet:py-10 tablet:pb-14">
          <slot />
        </div>
      </Card>

      <PostEndMatter previousPost={previousPost} nextPost={nextPost} />

      <CommentSection pageKey={pageKey} pageTitle={title} />
    </div>

    <TableOfContents headings={headings} variant="sidebar" />
  </div>
</BaseLayout>
