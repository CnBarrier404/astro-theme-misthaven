---
import Icon from "@/components/ui/Icon.astro";
import CommentSection from "@/components/content/CommentSection.astro";
import PostEndMatter from "@/components/content/PostEndMatter.astro";
import PostOutdatedWarning from "@/components/content/PostOutdatedWarning.astro";
import Spoiler from "@/components/content/Spoiler.astro";
import Card from "@/components/ui/Card.astro";
import PostMeta from "@/components/ui/PostMeta.astro";
import PostFloatingActions from "@/components/widget/PostFloatingActions.astro";
import TableOfContents from "@/components/widget/TableOfContents.astro";
import { postConfig } from "@/config/postConfig";
import { siteConfig } from "@/config/siteConfig";
import { getTranslator, I18nKey } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate, getPostHref, getPostMetrics, getPostOgImageHref } from "@/utils/posts";
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  headings: MarkdownHeading[];
  previousPost?: CollectionEntry<"posts">;
  nextPost?: CollectionEntry<"posts">;
}

const { post, headings, previousPost, nextPost } = Astro.props;
const t = getTranslator();
const { title, description, publishedAt, updatedAt, category, tags, draft } = post.data;
const publishedLabel = formatPostDate(publishedAt);
const { wordCount, readingTime } = getPostMetrics(post);
const pageKey = getPostHref(post);
---

<BaseLayout
  title={`${title} · ${siteConfig.title}`}
  description={description}
  ogImage={{
    src: getPostOgImageHref(post),
    width: 1200,
    height: 630,
    alt: `${title} · ${siteConfig.title}`,
  }}
>
  <PostFloatingActions />
  <Spoiler />

  <div class="mx-auto w-full max-w-reading wide:flex wide:max-w-chrome wide:items-start wide:justify-center wide:gap-8">
    <div class="hidden w-72 shrink-0 wide:block" aria-hidden="true"></div>

    <div class="w-full max-w-reading min-w-0">
      <a class="mb-4 ml-1 inline-flex items-center gap-2 text-sm font-bold text-accent-strong" href="/posts">
        <Icon class="rotate-180" name="arrow" size={16} />
        {t(I18nKey.backToPosts)}
      </a>

      <Card as="article" class="w-full overflow-hidden" data-reading-content>
        <header class="border-b border-border px-5 py-8 tablet:px-12 tablet:py-10">
          <PostMeta wordCount={wordCount} readingTime={readingTime} pageKey={pageKey} />

          <div class="mt-4 flex items-start gap-3 tablet:mt-5 tablet:gap-4">
            <span class="h-4 w-1 flex-none self-center rounded-sm bg-accent tablet:h-5" aria-hidden="true"></span>
            <h1 class="m-0 text-4xl font-bold">{title}</h1>
          </div>

          <div
            class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-3 text-sm text-muted tablet:gap-x-5"
            aria-label={t(I18nKey.postInformation)}
          >
            <time class="inline-flex items-center gap-2" datetime={publishedAt.toISOString()}>
              <span class="grid size-8 place-items-center rounded-md bg-accent-soft text-accent-strong">
                <Icon name="calendar" size={16} />
              </span>
              {publishedLabel}
            </time>
            {updatedAt && (
              <time class="inline-flex items-center gap-2" datetime={updatedAt.toISOString()}>
                <span class="grid size-8 place-items-center rounded-md bg-accent-soft text-accent-strong">
                  <Icon name="clock" size={16} />
                </span>
                {t(I18nKey.postUpdatedAt, { date: formatPostDate(updatedAt) })}
              </time>
            )}
            <span class="inline-flex items-center gap-2">
              <span class="grid size-8 place-items-center rounded-md bg-accent-soft text-accent-strong">
                <Icon name="article" size={16} />
              </span>
              {category}
            </span>
            {tags.length > 0 && (
              <span class="inline-flex min-w-0 items-center gap-2">
                <span class="grid size-8 flex-none place-items-center rounded-md bg-accent-soft font-bold text-accent-strong">
                  #
                </span>
                <span class="text-text-soft">{tags.join(" / ")}</span>
              </span>
            )}
            {draft && (
              <span class="rounded-panel bg-draft-soft px-2 py-1 text-xs text-draft">
                {t(I18nKey.postDraftPreview)}
              </span>
            )}
          </div>

          {postConfig.outdatedWarning.enabled && (
            <PostOutdatedWarning
              lastUpdatedAt={updatedAt ?? publishedAt}
              thresholdDays={postConfig.outdatedWarning.days}
            />
          )}
        </header>

        <div class="prose-content px-5 py-8 tablet:px-12 tablet:py-10 tablet:pb-14">
          <slot />
        </div>
      </Card>

      <PostEndMatter previousPost={previousPost} nextPost={nextPost} />

      <CommentSection pageKey={pageKey} pageTitle={title} />
    </div>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
