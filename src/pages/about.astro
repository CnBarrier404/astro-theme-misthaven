---
import AboutPage from "@/components/about/AboutPage.astro";
import { getStandalonePage } from "@/utils/standalonePages";
import { render } from "astro:content";

const { entry: page } = await getStandalonePage("about");
const { Content } = await render(page);
---

<AboutPage title={page.data.title} description={page.data.description}>
  <Content />
</AboutPage>
