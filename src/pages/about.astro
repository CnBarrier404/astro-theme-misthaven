---
import AboutPage from "@/components/about/AboutPage.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "about");

if (!page) {
  throw new Error("Missing content entry: src/content/pages/about.md");
}

const { Content } = await render(page);
---

<AboutPage title={page.data.title} description={page.data.description}>
  <Content />
</AboutPage>
