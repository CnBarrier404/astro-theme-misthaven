---
import FriendsPage from "@/components/friends/FriendsPage.astro";
import { getStandalonePage } from "@/utils/standalonePages";
import { render } from "astro:content";

const { entry: page } = await getStandalonePage("friends");
const { Content } = await render(page);
---

<FriendsPage title={page.data.title} description={page.data.description}>
  <Content />
</FriendsPage>
