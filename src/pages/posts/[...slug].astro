---
import PostLayout from "@/layouts/PostLayout.astro";
import { getVisiblePosts } from "@/utils/posts";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, previousPost: posts[index - 1], nextPost: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} previousPost={previousPost} nextPost={nextPost}>
  <Content />
</PostLayout>
