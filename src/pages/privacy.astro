---
import Card from "@/components/ui/Card.astro";
import ReadingBody from "@/components/prose/ReadingBody.astro";
import { siteConfig } from "@/config/siteConfig";
import { I18nKey, t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate } from "@/utils/postDates";
import { getStandalonePage } from "@/utils/standalonePages";
import { render } from "astro:content";

const { entry: page } = await getStandalonePage("privacy");
const { Content } = await render(page);

const title = page.data.title ?? t(I18nKey.footerPrivacyPolicy);
const description = page.data.description ?? siteConfig.description.join(" ");
const updatedAt = page.data.updatedAt;
---

<BaseLayout title={`${title} · ${siteConfig.title}`} description={description}>
  <div class="mx-auto w-full max-w-reading">
    <Card as="article" class="w-full overflow-hidden">
      <header class="border-b border-border px-5 py-8 tablet:px-12 tablet:py-10">
        <h1 class="m-0 text-page-title font-semibold">{title}</h1>
        {updatedAt && (
          <p class="mt-3 mb-0 text-sm text-muted">{t(I18nKey.pageLastUpdated, { date: formatPostDate(updatedAt) })}</p>
        )}
      </header>
      <ReadingBody>
        <Content />
      </ReadingBody>
    </Card>
  </div>
</BaseLayout>
